# -- Python ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
build/
dist/

# -- Environment variables (contains API keys -- never commit) --
.env
.env.local

# -- Course materials: copyrighted, keep out of a public repo --
courses/*
!courses/.gitkeep

# -- Generated artifacts ----------------------------------------
outputs/*
!outputs/.gitkeep

# -- Vector store: rebuilt often during the skeleton phase --
# Once the index is stable and worth shipping with the repo,
# comment the three lines below out.
*.db
*.db-journal
*.db-wal

# -- Local model caches (fastembed / sentence-transformers) --
.cache/
models/

# -- Tooling caches ----------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# -- Editors / OS ----------------------------------------
.DS_Store
.idea/
*.swp

# Vector store directory (one .db per course)
index/
