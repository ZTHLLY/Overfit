# ========================================================
#  Generation model -- swap freely, existing index unaffected
# ========================================================
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.6:27b

# To switch to DeepSeek, change the three lines above to:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=deepseek-v4-flash

# ========================================================
#  Embedding model -- WARNING: changing this invalidates
#  the whole vector store and forces a full reindex.
#  Dimensionality is NOT configured here: it is probed on
#  first ingest and recorded in the database meta table.
# ========================================================
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
