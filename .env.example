# ========================================================
#  Where this file goes
#  Copy it to ~/.config/overfit/.env so every course folder
#  shares one set of keys; usually only LLM_API_KEY below
#  needs filling in. Real environment variables override
#  it. A .env in the current directory is read only with
#  --course (repository workflow); in a course folder it is
#  ignored, so a downloaded folder cannot redirect your keys.
# ========================================================

# ========================================================
#  Generation model -- swap freely, existing index unaffected
#  Default: DeepSeek's hosted API.
# ========================================================
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# ========================================================
#  Embedding model -- WARNING: changing this invalidates
#  the whole vector store and forces a full reindex.
#  Dimensionality is NOT configured here: it is probed on
#  first ingest and recorded in the database meta table.
# ========================================================
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# ========================================================
#  Reranker -- query-time only; changing it does NOT require
#  rebuilding the BGE-M3 index. No query means no key is needed;
#  whole-course `overfit mock` never queries.
#  A query with a missing key fails immediately; it never falls
#  back silently to vector-only retrieval. CLI --rerank-* values
#  override these settings for one invocation.
# ========================================================
OVERFIT_RERANK_PROVIDER=openrouter
OVERFIT_RERANK_BASE_URL=https://openrouter.ai/api/v1
OVERFIT_RERANK_API_KEY=
OVERFIT_RERANK_MODEL=voyageai/rerank-3
OVERFIT_RERANK_TIMEOUT=30

# ========================================================
#  Project paths -- only used with --course.
#  Without --course, the current directory is the course:
#  the index goes in ./.overfit/ and exams next to the files.
#  Relative values are resolved from the working directory.
#  The course directory is read in place; source files are not copied.
# ========================================================
# Relative paths here resolve against wherever the command runs,
# so leave them commented out in ~/.config/overfit/.env.
# COURSES_DIR=courses
# OUTPUTS_DIR=outputs
# INDEX_DIR=index

# ========================================================
#  Parsing (layer 2)
#  Which backend turns a PDF into text. Recorded in the
#  index: switching it changes every chunk, so the store
#  refuses to open until you rebuild.
#    pypdf            fast, pure Python, no models.
#                     Flattens tables and formulas into
#                     scattered short lines.
#    docling          layout-aware: real tables, reading
#                     order, section headings. ~10x slower,
#                     needs `uv sync --extra docling`.
#    docling+formula  as above, plus equations to LaTeX.
#                     Slower again; compare before trusting.
#  Switching:  overfit ingest --course X --rebuild
# ========================================================
PDF_BACKEND=pypdf

# ========================================================
#  Chunking (layer 3)
#  250 tokens ~= 1000 chars: a lecture slide (200-300 chars)
#  stays whole, a prose handout page (1400-1800) splits in two.
# ========================================================
CHUNK_SIZE=250
CHUNK_OVERLAP=25

# ========================================================
#  Input formats
#  Parsers exist for .pdf, .md, .markdown and .txt, but PDF
#  is the conservative default to avoid indexing duplicate exports.
# ========================================================
EXTENSIONS=.pdf

# ========================================================
#  Generation (layer 7)
# ========================================================
NUM_QUESTIONS=30
TEMPERATURE=0.3
MAX_RETRIES=3
REQUEST_TIMEOUT=900
