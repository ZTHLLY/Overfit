# ========================================================
#  Generation model -- swap freely, existing index unaffected
# ========================================================
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.6:27b

# When Overfit runs inside Docker but Ollama runs on the host, override the
# two BASE_URL values for that process with host.docker.internal. Keep
# localhost in this file so native runs remain portable.

# To switch to DeepSeek, change the three lines above to:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=deepseek-v4-flash

# ========================================================
#  Embedding model -- WARNING: changing this invalidates
#  the whole vector store and forces a full reindex.
#  Dimensionality is NOT configured here: it is probed on
#  first ingest and recorded in the database meta table.
# ========================================================
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# ========================================================
#  Project paths
#  Relative values are resolved from the working directory.
#  The course directory is read in place; source files are not copied.
# ========================================================
COURSES_DIR=courses
OUTPUTS_DIR=outputs
INDEX_DIR=index

# ========================================================
#  Parsing (layer 2)
#  Which backend turns a PDF into text. Recorded in the
#  index: switching it changes every chunk, so the store
#  refuses to open until you rebuild.
#    pypdf            fast, pure Python, no models.
#                     Flattens tables and formulas into
#                     scattered short lines.
#    docling          layout-aware: real tables, reading
#                     order, section headings. ~10x slower,
#                     needs `uv sync --extra docling`.
#    docling+formula  as above, plus equations to LaTeX.
#                     Slower again; compare before trusting.
#  Switching:  overfit ingest --course X --rebuild
# ========================================================
PDF_BACKEND=pypdf

# ========================================================
#  Chunking (layer 3)
#  250 tokens ~= 1000 chars: a lecture slide (200-300 chars)
#  stays whole, a prose handout page (1400-1800) splits in two.
# ========================================================
CHUNK_SIZE=250
CHUNK_OVERLAP=25

# ========================================================
#  Input formats
#  Parsers exist for .pdf, .md, .markdown and .txt, but PDF
#  is the conservative default to avoid indexing duplicate exports.
# ========================================================
EXTENSIONS=.pdf

# ========================================================
#  Generation (layer 7)
# ========================================================
TEMPERATURE=0.3
MAX_RETRIES=3
REQUEST_TIMEOUT=900
